{
  "name": "portfolio-production",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:node && npm run test:python",
    "test:node": "node --test tests/worker.test.mjs",
    "test:python": "python -m unittest discover -s tests -v",
    "test:e2e": "playwright test",
    "build": "python scripts/build.py",
    "dev": "node scripts/wrangler.mjs dev",
    "check:worker": "node scripts/wrangler.mjs deploy --dry-run --outdir .artifacts/worker",
    "deploy": "node scripts/wrangler.mjs deploy"
  },
  "devDependencies": {
    "wrangler": "4.132.0",
    "@playwright/test": "1.58.2"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "leaflet": "1.9.4",
    "nunjucks": "3.2.4"
  }
}
